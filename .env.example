# Stock iPhone Duo (/stock-iphone) — background alerts.
# Copy to .env.local for local development. Without Redis, watches are stored in .data/ locally.

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@lycapps.com

# Protects /api/cron/stock-check. Any long random string (openssl rand -hex 32).
CRON_SECRET=

# Upstash Redis (Vercel Marketplace sets KV_REST_API_URL / KV_REST_API_TOKEN automatically;
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted too).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional e-mail alerts through Resend (https://resend.com).
RESEND_API_KEY=
ALERT_EMAIL_FROM=
